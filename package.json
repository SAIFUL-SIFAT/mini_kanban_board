{
  "name": "mini-kanban-board",
  "version": "1.0.0",
  "description": "Fullstack Mini Kanban Board with Next.js, Tailwind CSS, NestJS, and Prisma (PostgreSQL)",
  "private": true,
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run start:dev --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build": "npm run build:backend && npm run build:frontend",
    "prisma:generate": "npm run prisma:generate --prefix backend",
    "prisma:migrate": "npm run prisma:migrate --prefix backend"
  },
  "keywords": [
    "kanban",
    "nextjs",
    "tailwindcss",
    "nestjs",
    "prisma",
    "postgresql"
  ],
